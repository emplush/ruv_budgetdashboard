{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "RequireHttps": false,
    "HttpsPort": 443,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "SessionMinutes": 30,
    "LoginRequestsPer5Minutes": 40
  },
  "Storage": {
    "Path": ""
  }
}
