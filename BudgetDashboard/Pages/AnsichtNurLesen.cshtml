@page
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Nur Ansicht";
}
<section class="page">
    <p class="topline">Ansicht</p>
    <h1 class="headline">Hier sind keine Änderungen möglich.</h1>
    <p class="copy">Du siehst die Anwendung so, wie die Kostenstelle sie sieht. Die Ansicht dient nur zum Anschauen. Es wurde nichts gespeichert. Gehe zurück und schau Dich weiter um.</p>
    <a class="btn btn--primary" asp-page="/Index">Zur Startseite der Ansicht</a>
</section>
