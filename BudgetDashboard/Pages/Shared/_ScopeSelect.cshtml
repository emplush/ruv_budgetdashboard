@model ScopeInfo
@if (Model.Choices.Count > 0)
{
    var current = ViewContext.RouteData.Values["page"] as string ?? "/Budgetplan/Index";
    var jahr = Context.Request.Query["jahr"].ToString();
    <form method="get" asp-page="@current" class="scope-form">
        @if (jahr.Length > 0) { <input type="hidden" name="jahr" value="@jahr" /> }
        <div class="field">
            <label for="ks">Kostenstelle</label>
            <select id="ks" name="ks" data-autosubmit>
                @foreach (var c in Model.Choices)
                {
                    <option value="@c.Number" selected="@(c.Number == Model.Number)">@c.Label</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn--ghost">Anzeigen</button>
    </form>
}
