@page
@attribute [Authorize(Policy = "User")]
@inject AccountService Accounts
@{
    ViewData["Title"] = "Dashboard";
    var profile = Accounts.Profile(User.Identity!.Name!);
}
<section class="page">
    <p class="topline">Willkommen</p>
    <h1 class="headline">Dashboard</h1>
    <div class="card card--soft">
        <h2 class="headline-s">Deine Kostenstelle</h2>
        <dl class="facts">
            <dt>Kostenstelle</dt><dd>@User.Identity.Name</dd>
            <dt>Org-Einheit</dt><dd>@(string.IsNullOrEmpty(profile?.OrgUnit) ? "–" : profile!.Value.OrgUnit)</dd>
            <dt>Gruppe</dt><dd>@(string.IsNullOrEmpty(profile?.Group) ? "–" : profile!.Value.Group)</dd>
            <dt>Rolle</dt><dd>@Roles.Label(profile?.Role ?? "")</dd>
        </dl>
        <p class="copy">Hier entsteht Dein Dashboard. Es wird demnächst gefüllt.</p>
    </div>
</section>
