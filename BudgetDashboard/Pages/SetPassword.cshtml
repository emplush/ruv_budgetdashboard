@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Passwort setzen";
    ViewData["Auth"] = true;
}
<section class="auth">
    <div class="card auth__card" role="dialog" aria-labelledby="dlg-title">
        <p class="topline">Erste Anmeldung</p>
        <h1 class="headline" id="dlg-title">Bitte setze ein Passwort</h1>
        <p class="copy">Für die Kostenstelle <strong>@Model.Number</strong> gibt es noch kein Passwort. Lege jetzt Dein persönliches Passwort fest.</p>

        <partial name="_Errors" model="Model.Errors" />

        <form method="post" class="form" autocomplete="off">
            <div class="field">
                <label for="neu">Neues Passwort</label>
                <input id="neu" name="NeuesPasswort" type="password" maxlength="128" required autocomplete="new-password" autofocus />
            </div>
            <div class="field">
                <label for="wdh">Passwort wiederholen</label>
                <input id="wdh" name="Wiederholung" type="password" maxlength="128" required autocomplete="new-password" />
            </div>
            <partial name="_PasswordRules" />
            <div class="actions">
                <button type="submit" class="btn btn--primary">Passwort speichern</button>
                <a class="btn btn--ghost" asp-page="/Login">Abbrechen</a>
            </div>
        </form>
    </div>
</section>
